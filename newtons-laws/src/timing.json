{"voice": false, "fps": 30, "total": 8846, "scenes": [{"id": "hook", "start": 24, "end": 548}, {"id": "law1", "start": 548, "end": 2553}, {"id": "law2", "start": 2553, "end": 5025}, {"id": "law3", "start": 5025, "end": 6725}, {"id": "recap", "start": 6725, "end": 8846}], "lines": {"h1": {"pages": [[0, 9]], "start": 45, "end": 166, "speechEnd": 151, "scene": "hook", "emotion": "question", "text": "Why do you lurch forward when a bus suddenly brakes?", "words": [{"w": "Why", "s": 50, "e": 56}, {"w": "do", "s": 56, "e": 60}, {"w": "you", "s": 60, "e": 66}, {"w": "lurch", "s": 66, "e": 77}, {"w": "forward", "s": 77, "e": 92}, {"w": "when", "s": 92, "e": 100}, {"w": "a", "s": 100, "e": 104}, {"w": "bus", "s": 104, "e": 111}, {"w": "suddenly", "s": 111, "e": 127}, {"w": "brakes?", "s": 127, "e": 146}]}, "h2": {"pages": [[0, 6]], "start": 192, "end": 280, "speechEnd": 269, "scene": "hook", "emotion": "surprise", "text": "Nobody pushed you. So what just happened?", "words": [{"w": "Nobody", "s": 196, "e": 207}, {"w": "pushed", "s": 207, "e": 217}, {"w": "you.", "s": 217, "e": 228}, {"w": "So", "s": 228, "e": 231}, {"w": "what", "s": 231, "e": 238}, {"w": "just", "s": 238, "e": 245}, {"w": "happened?", "s": 245, "e": 264}]}, "h3": {"pages": [[0, 9]], "start": 291, "end": 397, "speechEnd": 397, "scene": "hook", "emotion": "fun", "text": "The answer hides in three rules from Sir Isaac Newton.", "words": [{"w": "The", "s": 295, "e": 301}, {"w": "answer", "s": 301, "e": 314}, {"w": "hides", "s": 314, "e": 324}, {"w": "in", "s": 324, "e": 328}, {"w": "three", "s": 328, "e": 339}, {"w": "rules", "s": 339, "e": 349}, {"w": "from", "s": 349, "e": 357}, {"w": "Sir", "s": 357, "e": 363}, {"w": "Isaac", "s": 363, "e": 374}, {"w": "Newton.", "s": 374, "e": 392}]}, "h4": {"pages": [[0, 10]], "start": 407, "end": 523, "speechEnd": 523, "scene": "hook", "emotion": "fun", "text": "Let's master them with autos, cricket balls and an ISRO rocket!", "words": [{"w": "Let's", "s": 412, "e": 419},