# Copy to .env next to docker-compose.yml, then fill in real values.
#   cp .env.example .env
#
# .env must be listed in BOTH .gitignore and .dockerignore. Confirm with:
#   git check-ignore -v .env
#
# ---------------------------------------------------------------------------
# READ THIS BEFORE ADDING ANYTHING
# ---------------------------------------------------------------------------
# Vite substitutes VITE_* variables into the JavaScript bundle at build time.
# They are shipped to every visitor's browser and are trivially readable with
# View Source. A .env file protects them from your git history, NOT from users.
#
# Safe here:   the Supabase URL and anon (publishable) key - designed to be
#              public, and useless to an attacker as long as Row Level Security
#              is enabled on every table.
# Never here:  SUPABASE_SERVICE_ROLE_KEY, Stripe secret keys, SMTP passwords,
#              OpenAI keys, or any token that grants write access on its own.
#              Those belong in a Supabase Edge Function's secrets, where they
#              stay server-side.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
