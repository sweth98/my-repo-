# Reference only. Generate a real .env with:
#
#   ./generate-secrets.sh
#
# These are server-side secrets. They are passed to the API container at
# runtime and never reach the browser - unlike a Vite VITE_* variable, which is
# compiled into the JavaScript bundle and is public by definition.
#
# .env must be listed in .gitignore and .dockerignore. Verify with:
#   git check-ignore -v .env

# 32 random bytes, hex. Signs session cookies; anyone holding it can forge a
# session for any user.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-64-hex-characters

DEMO_USER=demo

# scrypt hash as "salt:hash", both hex. Never a plaintext password.
#   node api/scripts/hash-password.js 'your-password'
DEMO_PASSWORD_HASH=replace-me

# Marks the session cookie Secure (HTTPS-only). Must be true anywhere real TLS
# is in use; false only so the demo works over http://localhost.
COOKIE_SECURE=false

SESSION_TTL_SECONDS=3600
